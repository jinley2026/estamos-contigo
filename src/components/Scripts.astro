<script is:inline>
/* Mejora progresiva. La web funciona entera sin este script.
   Nada de lo que hace sale del dispositivo: no hay peticiones de red, ni analítica, ni registros. */
(function () {
  var doc = document.documentElement;
  doc.classList.add('js');

  /* Preferencias de lectura guardadas solo en este navegador (almacenamiento técnico, documentado en Cookies). */
  function leer(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function guardar(k, v) { try { if (v) localStorage.setItem(k, v); else localStorage.removeItem(k); } catch (e) {} }
  if (leer('ec-texto') === '1') doc.classList.add('texto-grande');
  if (leer('ec-contraste') === '1') doc.classList.add('contraste');

  var ahora = Date.now();
  function hora(ms) {
    try {
      return new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' }).format(new Date(ms));
    } catch (e) { return new Date(ms).toISOString(); }
  }

  /* Control de caducidad: un dato comprobado hace más de su plazo pasa a «pendiente de revisión».
     Los datos sensibles (teléfonos) ocultan además el botón de llamada. */
  var items = document.querySelectorAll('[data-comprobado][data-revisar]');
  for (var i = 0; i < items.length; i++) {
    var el = items[i];
    var t = Date.parse(el.getAttribute('data-comprobado'));
    var min = parseInt(el.getAttribute('data-revisar'), 10);
    if (!isNaN(t) && !isNaN(min) && ahora > t + min * 60000) {
      el.classList.add('caducado');
      var aviso = el.querySelector('.aviso-caducado');
      if (aviso) aviso.textContent = 'Pendiente de revisión: última comprobación ' + hora(t) + '. Consulta la fuente oficial antes de actuar.';
    }
  }

  /* Modo seguro automático: si el equipo no ha revisado la web en el plazo fijado,
     se avisa y se ocultan los bloques que se presentan como información al día. */
  var b = document.body;
  var ult = Date.parse(b.getAttribute('data-ultima-revision'));
  var maxh = parseFloat(b.getAttribute('data-max-horas'));
  if (!isNaN(ult) && !isNaN(maxh) && ahora > ult + maxh * 3600000) {
    b.classList.add('modo-seguro');
    var banda = document.querySelector('.banda-modo-seguro');
    if (banda) banda.hidden = false;
  }

  /* «Actualizado hace X min» y recarga automática cada 10 minutos en las páginas informativas.
     No recarga si la persona está escribiendo, ni si la pestaña está en segundo plano. */
  var marcas = document.querySelectorAll('[data-actualizado]');
  function pintarHace() {
    for (var m = 0; m < marcas.length; m++) {
      var tA = Date.parse(marcas[m].getAttribute('data-actualizado'));
      var hueco = marcas[m].querySelector('.uh-hace');
      if (!isNaN(tA) && hueco) {
        var min = Math.max(0, Math.round((Date.now() - tA) / 60000));
        hueco.textContent = min < 1 ? '(hace menos de un minuto)' : min < 120 ? '(hace ' + min + ' min)' : '(hace más de 2 horas)';
      }
    }
  }
  pintarHace();
  setInterval(pintarHace, 60000);
  var seg = parseInt(b.getAttribute('data-autorecarga'), 10);
  if (!isNaN(seg)) {
    var inicio = Date.now();
    setInterval(function () {
      var escribiendo = document.activeElement && /TEXTAREA|INPUT/.test(document.activeElement.tagName);
      if (document.visibilityState === 'visible' && !escribiendo && Date.now() - inicio >= seg * 1000) location.reload();
    }, 30000);
  }

  /* Alertas: los comunicados nuevos se muestran durante 60 minutos desde su publicación. */
  var alertasN = document.querySelectorAll('.alerta-nueva[data-hasta]');
  for (var an = 0; an < alertasN.length; an++) if (Date.now() < Date.parse(alertasN[an].getAttribute('data-hasta'))) alertasN[an].hidden = false;

  /* Vigencia del ciclo automático: «hace X min» y aviso si lleva más de una hora sin ejecutarse. */
  var es = document.querySelector('[data-ultima-consulta]');
  if (es) {
    var tc = Date.parse(es.getAttribute('data-ultima-consulta'));
    var pintarCiclo = function () {
      var mins = Math.round((Date.now() - tc) / 60000);
      var h = es.querySelector('.es-hace');
      if (h) h.textContent = mins < 1 ? '(hace menos de un minuto)' : '(hace ' + (mins < 120 ? mins + ' min' : Math.round(mins / 60) + ' h') + ')';
      var r = es.querySelector('.es-retraso');
      if (r) r.hidden = !(mins > 65);
    };
    if (!isNaN(tc)) { pintarCiclo(); setInterval(pintarCiclo, 60000); }
  }

  /* Buscador local: busca en el índice verificado incluido en la página. Nada sale del dispositivo. */
  var bus = document.querySelector('[data-buscador]');
  if (bus) {
    var datosIdx = [];
    try { datosIdx = JSON.parse(document.getElementById('indice-busqueda').textContent); } catch (e) {}
    var norm = function (s) { return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, ' ').trim(); };
    var VAC = ' que cual cuales cuanto cuantos cuantas como donde el la los las de del un una unos en a por con se sobre hay ha han es son fue al lo y o para su sus me mi esta este ese esa iban iba han dijo ';
    var GEN = ' tren trenes accidente urda toledo informacion oficial oficiales datos sobre ';
    var SIN = { muertos: 'fallecidos', muertes: 'fallecidos', murieron: 'fallecidos', fallecidas: 'fallecidos', viajeros: 'pasajeros', personas: 'pasajeros', billete: 'billetes', heridas: 'heridos', hospitales: 'hospital', telefonos: 'telefono' };
    var entrada = bus.querySelector('input');
    var caja = bus.querySelector('.resultados');
    var sinDato = bus.getAttribute('data-sin-dato');
    var buscar = function (q) {
      var toks = norm(q).split(' ').filter(function (t) { return t.length > 1 && VAC.indexOf(' ' + t + ' ') < 0; }).map(function (t) { return SIN[t] || t; });
      caja.textContent = '';
      if (!toks.length) return;
      var res = datosIdx.map(function (d) {
        var hay = ' ' + norm(d.titulo + ' ' + d.respuesta + ' ' + d.claves) + ' ';
        var tit = ' ' + norm(d.titulo) + ' ';
        var p = 0, total = 0;
        toks.forEach(function (t) {
          var peso = GEN.indexOf(' ' + t + ' ') > -1 ? 0.3 : 1;
          total += peso;
          var raiz = t.length > 5 ? t.slice(0, 5) : t;
          if (hay.indexOf(' ' + raiz) > -1) p += peso * (tit.indexOf(' ' + raiz) > -1 ? 1.5 : 1);
        });
        return { d: d, p: total ? p / total : 0 };
      }).filter(function (r) { return r.p >= 0.5; }).sort(function (a, b) { return b.p - a.p; }).slice(0, 5);
      if (!res.length) { var n = document.createElement('p'); n.className = 'caja'; n.textContent = sinDato; caja.appendChild(n); return; }
      res.forEach(function (r) {
        var art = document.createElement('article'); art.className = 'resultado';
        var h = document.createElement('h2'); h.textContent = r.d.titulo; art.appendChild(h);
        var p = document.createElement('p'); p.textContent = r.d.respuesta; art.appendChild(p);
        var m = document.createElement('p'); m.className = 'cifra-fuente';
        if (r.d.fuente) { var a = document.createElement('a'); a.href = r.d.fuente.url; a.rel = 'noopener noreferrer'; a.textContent = r.d.fuente.titulo; m.appendChild(document.createTextNode('Fuente: ')); m.appendChild(a); }
        if (r.d.hora) m.appendChild(document.createTextNode(' · ' + r.d.hora));
        art.appendChild(m);
        var v = document.createElement('a'); v.href = r.d.enlace; v.textContent = 'Ver en la web'; art.appendChild(v);
        caja.appendChild(art);
      });
    };
    var temporizador;
    entrada.addEventListener('input', function () { clearTimeout(temporizador); temporizador = setTimeout(function () { buscar(entrada.value); }, 200); });
    var ejs = bus.querySelectorAll('[data-ejemplo]');
    for (var ej = 0; ej < ejs.length; ej++) ejs[ej].addEventListener('click', function () { entrada.value = this.getAttribute('data-ejemplo'); buscar(entrada.value); });
  }

  /* Filtros de comunicados por organismo */
  var filtros = document.querySelectorAll('[data-filtro]');
  for (var fi = 0; fi < filtros.length; fi++) filtros[fi].addEventListener('click', function () {
    var cat = this.getAttribute('data-filtro');
    for (var fj = 0; fj < filtros.length; fj++) filtros[fj].setAttribute('aria-pressed', filtros[fj] === this ? 'true' : 'false');
    var items = document.querySelectorAll('[data-categoria]');
    for (var k2 = 0; k2 < items.length; k2++) items[k2].hidden = !(cat === 'todos' || items[k2].getAttribute('data-categoria') === cat);
  });

  /* Ajustes de lectura */
  document.addEventListener('click', function (ev) {
    var btn = ev.target.closest ? ev.target.closest('[data-accion]') : null;
    if (!btn) return;
    var a = btn.getAttribute('data-accion');
    if (a === 'texto-grande') { var on = doc.classList.toggle('texto-grande'); guardar('ec-texto', on ? '1' : ''); }
    if (a === 'contraste') { var on2 = doc.classList.toggle('contraste'); guardar('ec-contraste', on2 ? '1' : ''); }
    if (a === 'escuchar') {
      if (!('speechSynthesis' in window)) { btn.textContent = 'Tu navegador no permite la lectura en voz alta'; return; }
      if (speechSynthesis.speaking) { speechSynthesis.cancel(); btn.textContent = 'Escuchar esta página'; return; }
      var main = document.getElementById('contenido');
      var u = new SpeechSynthesisUtterance(main ? main.innerText : '');
      u.lang = doc.lang || 'es-ES';
      u.onend = function () { btn.textContent = 'Escuchar esta página'; };
      speechSynthesis.speak(u);
      btn.textContent = 'Detener lectura';
    }
  });

  /* «Avisar a mi familia»: el texto se compone en el dispositivo y se entrega a la app del propio usuario. */
  var eds = document.querySelectorAll('[data-editor-mensaje]');
  for (var j = 0; j < eds.length; j++) (function (ed) {
    var area = ed.querySelector('textarea');
    var mencion = ed.querySelector('input[type=checkbox]');
    var textoMencion = ed.getAttribute('data-mencion') || '';
    var estado = ed.querySelector('.estado-copia');
    var base = area.value;
    function texto() { return (area.value || '').trim(); }
    function aplicarMencion() {
      var sin = area.value.replace(' ' + textoMencion, '').replace(textoMencion, '');
      area.value = mencion.checked ? (sin.trim() + ' ' + textoMencion) : sin.trim();
    }
    var opciones = ed.querySelectorAll('[data-plantilla]');
    for (var k = 0; k < opciones.length; k++) opciones[k].addEventListener('click', function (e) {
      e.preventDefault();
      area.value = this.getAttribute('data-plantilla');
      for (var q = 0; q < opciones.length; q++) opciones[q].setAttribute('aria-pressed', opciones[q] === this ? 'true' : 'false');
      if (mencion.checked) aplicarMencion();
      area.focus();
    });
    mencion.addEventListener('change', aplicarMencion);
    ed.querySelector('[data-enviar=whatsapp]').addEventListener('click', function () {
      window.location.href = 'https://wa.me/?text=' + encodeURIComponent(texto());
    });
    ed.querySelector('[data-enviar=sms]').addEventListener('click', function () {
      window.location.href = 'sms:?&body=' + encodeURIComponent(texto());
    });
    var bc = ed.querySelector('[data-enviar=copiar]');
    bc.addEventListener('click', function () {
      var ok = function () { estado.textContent = bc.getAttribute('data-ok') || 'Copiado'; };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(texto()).then(ok, function () { area.select(); });
      } else { area.select(); try { document.execCommand('copy'); ok(); } catch (e) {} }
    });
    var bs = ed.querySelector('[data-enviar=compartir]');
    if (navigator.share) {
      bs.hidden = false;
      bs.addEventListener('click', function () { navigator.share({ text: texto() }).catch(function () {}); });
    }
    if (!base) area.value = '';
  })(eds[j]);
})();
</script>
