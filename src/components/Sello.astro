---
// Sello por información. A petición de Lin (28/10, 12:32) ya no se muestran carteles amarillos por apartado:
// la incertidumbre general se explica una sola vez en la nota superior (NotaGeneral.astro).
// Solo se muestra el sello positivo cuando el dato tiene origen oficial y está verificado por dos personas.
// «Fuente oficial comprobada» describe nuestra revisión, no una certificación oficial (V3 §9).
import { confirmadoOficial, verificado } from '../lib/datos';
interface Props { e: any }
const { e } = Astro.props;
---
{confirmadoOficial(e) && verificado(e) && <span class="sello-ok" title="Hemos comprobado el comunicado en la web del organismo. No es una certificación oficial.">Fuente oficial comprobada</span>}
