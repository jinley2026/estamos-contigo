---
// «Avisar a mi familia» (función «Estoy a salvo» del prompt maestro).
// Sin registro, sin identidad, sin teléfonos, sin envío desde servidores.
// Sin JavaScript: enlaces directos a WhatsApp/SMS con el texto ya escrito.
// Con JavaScript: editor local, opción de mencionar el accidente, copiar y compartir nativo.
import { mensajes, i18n } from '../lib/datos';
interface Props { lang?: 'es' | 'en' | 'fr' | 'pt' | 'it' | 'de' }
const { lang = 'es' } = Astro.props;
const plantillas = (mensajes.plantillas as Record<string, string[]>)[lang];
const mencion = (mensajes.menciones as Record<string, string>)[lang];
const t = lang === 'es'
  ? { anadirMencion: 'Mencionar el accidente en el mensaje', enviarWhatsapp: 'Enviar por WhatsApp', enviarSms: 'Enviar por SMS', copiar: 'Copiar texto', compartir: 'Compartir', copiado: 'Copiado', editar: 'Puedes cambiar el texto antes de enviarlo:', elegir: 'Elige un mensaje:' }
  : { ...(i18n.textos as Record<string, any>)[lang], editar: '✎', elegir: '' };
const wa = (s: string) => `https://wa.me/?text=${encodeURIComponent(s)}`;
const sms = (s: string) => `sms:?&body=${encodeURIComponent(s)}`;
---
<div class="mensaje-familia">
  <p class="caja">
    {lang === 'es'
      ? 'El mensaje se escribe en tu teléfono y lo envías tú desde tu propia aplicación. Esta web no recibe, no guarda y no ve lo que escribes. No es una confirmación oficial del estado de nadie.'
      : t.mensajeTexto}
  </p>

  <div class="editor" data-editor-mensaje data-mencion={mencion}>
    {lang === 'es' && <p><strong>{t.elegir}</strong></p>}
    <div class="acciones" role="group" aria-label={lang === 'es' ? 'Mensajes predefinidos' : 'Templates'}>
      {plantillas.map((p) => <button type="button" data-plantilla={p}>{p}</button>)}
    </div>
    <label for={`texto-${lang}`}>{lang === 'es' ? t.editar : t.mensajeTitulo}</label>
    <textarea id={`texto-${lang}`} maxlength="500" autocomplete="off" spellcheck="true">{plantillas[0]}</textarea>
    <div class="opcion">
      <input type="checkbox" id={`mencion-${lang}`} />
      <label for={`mencion-${lang}`}>{t.anadirMencion}</label>
    </div>
    <div class="acciones">
      <button type="button" class="principal" data-enviar="whatsapp">{t.enviarWhatsapp}</button>
      <button type="button" data-enviar="sms">{t.enviarSms}</button>
      <button type="button" data-enviar="copiar" data-ok={t.copiado}>{t.copiar}</button>
      <button type="button" data-enviar="compartir" hidden>{t.compartir}</button>
    </div>
    <p class="estado-copia" role="status" aria-live="polite"></p>
  </div>

  <ul class="plantillas sin-js">
    {plantillas.map((p) => (
      <li class="plantilla">
        <p>{p}</p>
        <div class="acciones">
          <a class="principal" href={wa(p)} rel="noopener noreferrer">{t.enviarWhatsapp}</a>
          <a href={sms(p)}>{t.enviarSms}</a>
        </div>
      </li>
    ))}
  </ul>
</div>
