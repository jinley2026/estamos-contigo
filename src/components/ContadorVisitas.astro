---
// Contador fijo arriba (Lin, 28/10 12:00, 12:32, 14:08 y 15:23). Cuenta en tiempo real con Supabase:
// la base de datos guarda solo un número total; no hay cookies ni datos personales.
// Si no responde, se muestra «Datos no disponibles»: nunca se inventa una cifra.
import { SITE, ES_PREVIA } from '../lib/datos';
const cfg = (SITE as any).visitas;
const activo = cfg?.activo && cfg?.proveedor === 'supabase' && cfg?.url && cfg?.clavePublica && !ES_PREVIA;
const { inicio = false } = Astro.props as { inicio?: boolean };
---
<p class="barra-visitas" lang="es" data-contador-visitas data-cv={activo ? cfg.url : undefined} data-cv-clave={activo ? cfg.clavePublica : undefined}>
  {inicio && <a class="barra-inicio" href="index.html">&#8592; Inicio</a>}
  <span class="visitas-icono" aria-hidden="true">&#9679;</span>
  <span><strong class="visitas-total" data-visitas-total>{activo ? '…' : 'Datos no disponibles'}</strong><span class="txt-largo"> visitas a esta web</span><span class="txt-corto"> visitas</span></span>
  <a class="barra-como" href="privacidad.html#estadisticas">Cómo se cuentan</a>
</p>
