<style is:global>
  /* Dirección visual: señalética de orientación (estaciones, aeropuertos).
     Paneles azul señal con texto blanco grande, pictogramas en recuadro, amarillo solo para avisos.
     Tipografía Atkinson Hyperlegible (Braille Institute), servida desde el propio sitio: diseñada para leerse
     con baja visión y bajo estrés. Sin fuentes externas. */
  @font-face { font-family: "Atkinson"; src: url("fuentes/atkinson-hyperlegible-latin-400-normal.woff2") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Atkinson"; src: url("fuentes/atkinson-hyperlegible-latin-700-normal.woff2") format("woff2"); font-weight: 700; font-display: swap; }

  :root {
    --senal: #14365c;
    --senal-hondo: #0d2643;
    --senal-claro: #e6edf5;
    --tinta: #15191e;
    --tinta-suave: #4b5563;
    --papel: #ffffff;
    --niebla: #f1f3f6;
    --linea: #d3d9e1;
    --aviso: #f2b705;
    --aviso-fondo: #fff6d6;
    --aviso-tinta: #4d3800;
    --emergencia: #b3261e;
    --emergencia-fondo: #fdeceb;
    --foco: #f2b705;
    --base: 18px;
    --radio: 14px;
  }
  html { font-size: var(--base); -webkit-text-size-adjust: 100%; }
  html.texto-grande { --base: 22px; }
  html.contraste { --senal: #000; --senal-hondo: #000; --senal-claro: #fff; --tinta: #000; --tinta-suave: #000; --niebla: #fff; --linea: #000; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--papel); color: var(--tinta); font-family: "Atkinson", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; line-height: 1.5; }
  .contenedor { max-width: 720px; margin: 0 auto; padding: 0 16px; }
  a { color: var(--senal); text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible, textarea:focus-visible, summary:focus-visible, input:focus-visible { outline: 3px solid var(--foco); outline-offset: 2px; box-shadow: 0 0 0 5px var(--tinta); }
  h1 { font-size: 1.75rem; line-height: 1.15; margin: 1.4rem 0 .5rem; letter-spacing: -.01em; }
  h2 { font-size: 1.3rem; line-height: 1.2; margin: 2.2rem 0 .8rem; }
  h3 { font-size: 1.05rem; margin: 1rem 0 .3rem; }
  p, li { max-width: 64ch; }
  .subtitulo { color: var(--tinta-suave); margin-top: 0; font-size: 1.05rem; }
  .visualmente-oculto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .saltar { position: absolute; left: -9999px; top: 0; background: var(--aviso); color: #000; padding: .6rem 1rem; z-index: 10; font-weight: 700; }
  .saltar:focus { left: 8px; top: 8px; }

  /* Franjas superiores */
  .banda-previa { background: var(--aviso); color: #000; text-align: center; font-weight: 700; padding: .35rem 1rem; font-size: .8rem; }
  .banda-aviso { background: var(--senal-hondo); color: #fff; }
  .banda-aviso p { margin: 0 auto; max-width: 720px; padding: .55rem 16px; font-size: .88rem; display: flex; align-items: center; justify-content: space-between; gap: .4rem .8rem; flex-wrap: wrap; }
  .banda-aviso a.enlace-112 { flex: none; background: var(--emergencia); color: #fff; text-decoration: none; font-weight: 700; padding: .35rem .8rem; border-radius: 999px; font-size: .95rem; white-space: nowrap; }
  .banda-cierre, .banda-modo-seguro { background: var(--aviso-fondo); border-bottom: 3px solid var(--aviso); color: var(--aviso-tinta); }
  .banda-cierre p, .banda-modo-seguro p { margin: 0 auto; max-width: 720px; padding: .7rem 16px; }

  .cabecera { border-bottom: 1px solid var(--linea); }
  .cabecera-fila { display: flex; flex-wrap: wrap; gap: .4rem 1rem; align-items: center; justify-content: space-between; padding-top: .55rem; padding-bottom: .55rem; }
  .marca { display: flex; align-items: center; gap: .55rem; text-decoration: none; color: var(--senal); }
  .marca-texto { font-weight: 700; font-size: 1.15rem; }
  .utilidades { display: flex; gap: .9rem; font-size: .88rem; }
  .utilidades a { padding: .45rem 0; color: var(--tinta-suave); }

  /* Panel principal (portada): como un panel de señalización */
  .panel { background: var(--senal); color: #fff; margin: 0 -16px; padding: 1.4rem 16px 1.6rem; }
  .panel h1 { color: #fff; margin: 0 0 .2rem; font-size: 1.15rem; font-weight: 400; opacity: .9; }
  .panel .pregunta { font-size: clamp(1.4rem, 7vw, 1.9rem); line-height: 1.12; font-weight: 700; margin: .2rem 0 1rem; letter-spacing: -.01em; }

  /* Tarjeta del teléfono */
  .tarjeta-tel { border-radius: var(--radio); padding: 1rem 1.1rem 1.1rem; margin: 1rem 0; background: var(--papel); color: var(--tinta); border: 2px solid var(--senal); }
  .panel .tarjeta-tel { border: 0; margin: 0; box-shadow: 0 0 0 4px rgba(255,255,255,.18); }
  .tarjeta-tel.pendiente { box-shadow: 0 0 0 4px var(--aviso); }
  .tarjeta-tel .etiqueta { font-size: .95rem; font-weight: 700; margin: 0; color: var(--senal); }
  .tarjeta-tel .organismo { margin: .1rem 0 0; color: var(--tinta-suave); font-size: .92rem; }
  .tarjeta-tel .numero { font-size: clamp(1.7rem, 11vw, 2.6rem); font-weight: 700; letter-spacing: .01em; margin: .2rem 0 .1rem; color: var(--senal-hondo); line-height: 1.05; font-variant-numeric: tabular-nums; }
  .tarjeta-tel .finalidad { margin: 0 0 .2rem; font-size: .95rem; }
  .boton-llamar { display: flex; align-items: center; justify-content: center; gap: .6rem; background: var(--senal); color: #fff; text-decoration: none; font-weight: 700; padding: 1rem; border-radius: 12px; font-size: 1.2rem; margin: .8rem 0 .2rem; min-height: 60px; }
  .boton-llamar svg { flex: none; }
  .meta { font-size: .8rem; color: var(--tinta-suave); margin: .5rem 0 0; }
  .meta-fuentes { font-size: .8rem; margin: .4rem 0 0; }
  .meta-fuentes summary { padding: .2rem 0; font-weight: 400; color: var(--tinta-suave); }
  .tarjeta-tel details { border: 0; padding: 0; margin: .3rem 0 0; }
  .sello-pendiente { display: inline-block; background: var(--aviso); color: #000; font-weight: 700; font-size: .8rem; padding: .15rem .55rem; border-radius: 6px; margin-bottom: .3rem; }
  .sello-ok { display: inline-block; background: #e3f1e6; color: #14532d; border: 1px solid #2f7a45; font-weight: 700; font-size: .8rem; padding: .1rem .5rem; border-radius: 6px; }
  .fechas { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: .25rem .9rem; margin: .4rem 0; font-size: .85rem; }
  .fechas dt { font-weight: 700; color: var(--tinta-suave, #444); }
  .fechas dd { margin: 0; }
  .aviso-independencia { border: 2px solid #14365c; border-radius: 10px; padding: .9rem 1rem; margin: 1.2rem 0; background: #f3f6fa; }
  .aviso-independencia p { margin: .35rem 0; }
  .pie-visitas { font-size: .85rem; margin: .6rem 0 0; }
  .pie-visitas .prueba { background: var(--aviso); color: #000; font-weight: 700; padding: 0 .35rem; border-radius: 4px; }
  .lista-control { list-style: none; padding: 0; }
  .lista-control li { padding: .35rem 0; border-bottom: 1px solid #ddd; }
  .lista-control .ok::before { content: "Cumplido · "; font-weight: 700; color: #14532d; }
  .lista-control .no::before { content: "Pendiente · "; font-weight: 700; color: #8a1c1c; }
  .apto { font-weight: 700; padding: .6rem .8rem; border-radius: 8px; }
  .apto.no { background: #fbe9e9; color: #7a1414; border: 2px solid #b42318; }
  .apto.si { background: #e3f1e6; color: #14532d; border: 2px solid #2f7a45; }
  .aviso-caducado { display: none; background: var(--aviso-fondo); border-left: 4px solid var(--aviso); padding: .6rem .8rem; color: var(--aviso-tinta); font-weight: 700; }
  .caducado .aviso-caducado { display: block; }
  .caducado[data-sensible] .accion-llamar { display: none; }
  .caducado .estado-fresco { display: none; }

  /* Otros teléfonos dentro del panel */
  .otros-tel { list-style: none; padding: 0; margin: .8rem 0 0; display: grid; gap: .4rem; }
  .otros-tel li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .3rem .8rem; background: rgba(255,255,255,.1); border-radius: 10px; padding: .55rem .8rem; max-width: none; }
  .otros-tel a { color: #fff; font-weight: 700; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .otros-tel .sello-pendiente { margin: 0 0 0 .5rem; }
  .otros-tel .aviso-caducado { width: 100%; padding: .3rem .6rem; }

  /* Última hora: tablón de avisos, borde superior amarillo como un cartel informativo */
  .ultima-hora { margin: 1.6rem 0 0; border: 2px solid var(--senal); border-top: 8px solid var(--aviso); border-radius: var(--radio); padding: 0 1rem 1rem; }
  .uh-cabecera { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .2rem 1rem; padding-top: .9rem; }
  .uh-cabecera h2 { margin: 0; font-size: 1.45rem; }
  .uh-hora { margin: 0; font-size: .88rem; color: var(--tinta-suave); font-weight: 700; }
  .uh-previa { font-size: .8rem; background: var(--aviso-fondo); color: var(--aviso-tinta); padding: .3rem .6rem; border-radius: 6px; margin: .6rem 0 0; }
  .uh-bloque { border-top: 1px solid var(--linea); margin-top: .9rem; padding-top: .3rem; }
  .uh-bloque h3 { font-size: 1rem; color: var(--senal); margin: .6rem 0 .4rem; }
  .uh-cifras { display: grid; gap: .5rem; margin: 0; }
  .uh-cifras > div { background: var(--niebla); border-radius: 10px; padding: .6rem .8rem; display: grid; grid-template-columns: minmax(0, 6rem) minmax(0, 1fr); gap: .1rem .8rem; align-items: baseline; }
  .uh-cifras dt { grid-row: 1; }
  .uh-cifras dt { font-size: .85rem; color: var(--tinta-suave); }
  .uh-cifras dd { margin: 0; }
  .uh-valor { display: block; font-size: 1.5rem; font-weight: 700; line-height: 1.15; }
  .uh-sin-dato { display: block; font-size: .95rem; font-weight: 700; color: var(--tinta-suave); padding-top: .25rem; }
  .uh-fuente { display: block; font-size: .78rem; color: var(--tinta-suave); margin-top: .15rem; font-weight: 400; }
  .uh-fuente a { color: var(--tinta-suave); }
  .uh-nota { font-size: .85rem; color: var(--tinta-suave); margin: .6rem 0 0; }
  .uh-lista { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
  .uh-lista li { max-width: none; }
  .uh-papel { display: inline-block; font-size: .8rem; background: var(--senal-claro); color: var(--senal-hondo); border-radius: 6px; padding: .05rem .45rem; margin-left: .3rem; }
  .uh-alerta { background: var(--emergencia-fondo); border-left: 5px solid var(--emergencia); padding: .6rem .8rem; border-radius: 8px; font-weight: 700; margin: .7rem 0 0; }
  .uh-trenes { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
  .uh-trenes li { display: grid; gap: .1rem; background: var(--niebla); border-radius: 10px; padding: .6rem .8rem; max-width: none; }
  .uh-tren { font-weight: 700; font-size: 1.1rem; }
  .uh-pie { font-size: .82rem; color: var(--tinta-suave); margin: 1rem 0 0; }
  @media (min-width: 620px) { .uh-trenes { grid-template-columns: 1fr 1fr; } }

  /* V2: vigencia, alertas, situación, balance, trenes, cronología, buscador, comunicados */
  .estado-sistema { margin: 1rem 0 0; padding: .7rem .9rem; border-radius: 12px; background: var(--niebla); font-size: .85rem; }
  .estado-sistema dl { margin: 0; display: grid; gap: .3rem 1rem; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .estado-sistema dt { color: var(--tinta-suave); }
  .estado-sistema dd { margin: 0; font-weight: 700; }
  .es-alerta { margin: .6rem 0 0; background: var(--aviso-fondo); border-left: 5px solid var(--aviso); padding: .5rem .7rem; color: var(--aviso-tinta); font-weight: 700; }
  .es-nota { margin: .5rem 0 0; color: var(--tinta-suave); }
  .alertas { display: grid; gap: .5rem; margin: 1rem 0 0; }
  .alerta { margin: 0; padding: .7rem .9rem; border-radius: 10px; max-width: none; }
  .alerta-tel { background: var(--aviso-fondo); border-left: 6px solid var(--aviso); color: var(--aviso-tinta); }
  .alerta-nueva { background: var(--senal-claro); border-left: 6px solid var(--senal); }
  .situacion, .balance, .trenes, .novedades, .buscador-acceso { margin-top: 1.8rem; }
  .sit-resumen { font-size: 1.15rem; font-weight: 700; margin: 0 0 .6rem; }
  .sit-datos { display: grid; gap: .4rem; margin: 0; }
  .sit-datos > div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: .8rem; }
  .sit-datos dt { color: var(--tinta-suave); }
  .sit-datos dd { margin: 0; }
  .cifras { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .cifra { border: 2px solid var(--senal); border-radius: var(--radio); padding: .8rem .9rem; display: grid; gap: .15rem; max-width: none; }
  .cifra.pendiente { border-color: var(--aviso); }
  .cifra-etiqueta { color: var(--tinta-suave); font-size: .9rem; }
  .cifra-valor { font-size: 2rem; font-weight: 700; line-height: 1.1; color: var(--senal-hondo); font-variant-numeric: tabular-nums; }
  .cifra-estado { font-size: .85rem; font-weight: 700; display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
  .cifra-estado .sello-pendiente { margin: 0; }
  .cifra-fuente { font-size: .78rem; color: var(--tinta-suave); margin: .3rem 0 0; }
  .cifra-fuente a { color: var(--tinta-suave); }
  .cifra-discrepancia { font-size: .85rem; background: var(--aviso-fondo); color: var(--aviso-tinta); padding: .4rem .6rem; border-radius: 8px; margin-top: .3rem; }
  .sin-cifra { font-weight: 700; color: var(--tinta-suave); }
  .fichas { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); }
  .ficha { border: 2px solid var(--senal); border-radius: var(--radio); padding: .9rem 1rem; }
  .ficha.pendiente { border-color: var(--aviso); }
  .ficha h3 { margin: 0 0 .5rem; font-size: 1.4rem; color: var(--senal-hondo); }
  .ficha-servicio { background: var(--senal); color: #fff; border-radius: 6px; padding: .05rem .5rem; font-size: 1rem; vertical-align: .15em; }
  .ficha dl { margin: 0; display: grid; gap: .25rem; }
  .ficha dl > div { display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 1fr); gap: .6rem; border-bottom: 1px solid var(--linea); padding: .25rem 0; }
  .ficha dt { color: var(--tinta-suave); font-size: .9rem; }
  .ficha dt { min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .ficha dd { margin: 0; font-weight: 700; min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .ficha dd.sin { font-weight: 400; color: var(--tinta-suave); font-style: italic; }
  .ficha dd.destacado { font-size: 1.2rem; }
  .cronologia { list-style: none; padding: 0; margin: 0; }
  .hito { display: grid; grid-template-columns: 3.4rem minmax(0, 1fr); gap: .8rem; padding: .7rem 0; border-top: 1px solid var(--linea); max-width: none; }
  .hito time { font-weight: 700; color: var(--senal); font-variant-numeric: tabular-nums; }
  .hito-titulo { margin: 0; font-weight: 700; }
  .hito-meta { margin: .2rem 0 0; font-size: .8rem; color: var(--tinta-suave); display: flex; flex-wrap: wrap; gap: .3rem .7rem; align-items: center; }
  .hito-meta a { color: var(--tinta-suave); }
  .hito-meta .sello-pendiente { margin: 0; }
  .org { font-weight: 700; color: var(--tinta); }
  .boton-buscar { display: flex; align-items: center; gap: .7rem; padding: .9rem 1rem; border: 2px solid var(--senal); border-radius: 12px; text-decoration: none; font-weight: 700; color: var(--senal-hondo); min-height: 56px; }
  .buscador label { font-weight: 700; display: block; margin: 1rem 0 .3rem; }
  .buscador input { width: 100%; font: inherit; font-size: 1.15rem; padding: .8rem; border: 2px solid var(--senal); border-radius: 10px; }
  .ejemplos { display: flex; flex-wrap: wrap; gap: .4rem; margin: .7rem 0; }
  .ejemplos button { font: inherit; font-size: .85rem; padding: .45rem .7rem; border-radius: 999px; border: 1px solid var(--linea); background: var(--niebla); cursor: pointer; min-height: 40px; }
  .resultado { border-top: 1px solid var(--linea); padding: .8rem 0; }
  .resultado h2 { font-size: 1.05rem; margin: 0 0 .3rem; }
  .resultado p { margin: .2rem 0; }
  .filtros { margin: 1rem 0; }
  .lista-comunicados { list-style: none; padding: 0; margin: 0; }
  .comunicado { border-top: 1px solid var(--linea); padding: .9rem 0; max-width: none; }
  .comunicado h2 { font-size: 1.1rem; margin: .2rem 0; }
  .com-org { margin: 0; font-weight: 700; font-size: .9rem; display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
  .com-tipo { font-size: .75rem; padding: .1rem .45rem; border-radius: 6px; background: var(--niebla); font-weight: 700; }
  .com-tipo.comunicado-oficial { background: var(--senal); color: #fff; }
  .com-org .sello-pendiente { margin: 0; }
  code { font-size: .85em; background: var(--niebla); padding: .05rem .3rem; border-radius: 4px; overflow-wrap: anywhere; }
  table { display: block; overflow-x: auto; }

  /* Rutas: filas de señalética con pictograma en recuadro */
  .rutas { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: .6rem; }
  .rutas a { display: grid; grid-template-columns: 56px 1fr 20px; align-items: center; gap: .9rem; min-height: 76px; padding: .7rem .9rem .7rem .7rem; border-radius: var(--radio); text-decoration: none; color: var(--tinta); background: var(--niebla); border: 2px solid transparent; }
  .rutas a:hover { border-color: var(--senal); }
  .pictograma { width: 56px; height: 56px; border-radius: 10px; background: var(--senal); color: #fff; display: flex; align-items: center; justify-content: center; }
  .ruta-titulo { display: block; font-weight: 700; font-size: 1.15rem; line-height: 1.2; }
  .ruta-desc { display: block; font-size: .9rem; color: var(--tinta-suave); margin-top: .1rem; }
  .flecha { color: var(--senal); }
  @media (min-width: 620px) { .rutas { grid-template-columns: 1fr 1fr; } }

  /* Tres avisos breves */
  .avisos-rapidos { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: .5rem; }
  .avisos-rapidos li { display: flex; gap: .7rem; align-items: center; padding: .65rem .9rem; border-radius: 10px; background: var(--emergencia-fondo); font-weight: 700; max-width: none; }
  .avisos-rapidos svg { flex: none; color: var(--emergencia); }

  /* Pasos (solo donde el contenido es una secuencia real) */
  .pasos { list-style: none; padding: 0; margin: 1rem 0; counter-reset: paso; display: grid; gap: .7rem; }
  .pasos > li { counter-increment: paso; display: grid; grid-template-columns: 44px 1fr; gap: .8rem; align-items: start; max-width: none; }
  .pasos > li::before { content: counter(paso); width: 44px; height: 44px; border-radius: 50%; background: var(--senal); color: #fff; font-weight: 700; font-size: 1.25rem; display: flex; align-items: center; justify-content: center; }
  .pasos strong { display: block; font-size: 1.08rem; margin-top: .45rem; }
  .pasos p { margin: .15rem 0 0; color: var(--tinta-suave); }

  .resumen-lista { padding-left: 1.2rem; }
  .resumen-lista li { margin: .3rem 0; }

  .bloques { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); list-style: none; padding: 0; }
  .bloques a { display: block; padding: .75rem .9rem; border: 1px solid var(--linea); border-radius: 10px; text-decoration: none; color: var(--tinta); font-weight: 700; }
  .bloques a:hover { border-color: var(--senal); }
  .bloque-meta { display: block; font-weight: 400; }

  .caja { border-radius: 12px; padding: .9rem 1rem; margin: 1rem 0; background: var(--niebla); }
  .caja > :first-child { margin-top: 0; } .caja > :last-child { margin-bottom: 0; }
  .caja-no { background: var(--emergencia-fondo); border-left: 6px solid var(--emergencia); }
  .caja-pendiente { background: var(--aviso-fondo); color: var(--aviso-tinta); border-left: 6px solid var(--aviso); }
  .lista-check li { margin: .35rem 0; }

  .entrada { border-top: 1px solid var(--linea); padding: .9rem 0; }
  .entrada h3 { margin: 0 0 .3rem; }
  .entrada.retirado h3, .entrada.corregido h3 { text-decoration: line-through; }
  .nivel { display: inline-block; font-size: .78rem; font-weight: 700; padding: .1rem .45rem; border-radius: 4px; background: var(--senal-claro); color: var(--senal-hondo); }

  /* Avisar a mi familia */
  .plantillas { list-style: none; padding: 0; display: grid; gap: .6rem; }
  .plantilla { border: 1px solid var(--linea); border-radius: 12px; padding: .8rem; }
  .plantilla p { margin: 0 0 .5rem; font-weight: 700; }
  .acciones { display: flex; flex-wrap: wrap; gap: .5rem; }
