---
// Recuadro «Última hora»: balance oficial, trenes, hospitales, avisos de las autoridades y estado de la línea.
// Cada dato con su fuente y nivel. Lo que no tiene dato oficial se dice expresamente.
import { ultimahora as u, ES_PREVIA, visible, itemPublicable, confirmadoOficial, NO_CONFIRMADO } from '../lib/datos';
const hosp = u.hospitales.lista.filter((h: any) => itemPublicable(h));
const avisos = u.avisos.lista.filter((a: any) => itemPublicable(a));
const noOf = (x: any) => !confirmadoOficial(x);
const hora = (iso: string) => (iso ? new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' }).format(new Date(iso)) : '');
---
<section class="ultima-hora solo-normal temporal" id="asistencia" aria-labelledby="uh-titulo">
  <div class="uh-cabecera">
    <h2 id="uh-titulo">Asistencia y avisos</h2>
    <p class="uh-hora">Revisado a las {hora(u.actualizadoEn)}</p>
  </div>



  {visible(u.hospitales) && hosp.length > 0 && <div class="uh-bloque" data-comprobado={u.hospitales.comprobadoEn} data-revisar={u.hospitales.revisarCadaMinutos}>
    <h3>A dónde se traslada a los heridos</h3>
    <ul class="uh-lista">
      {hosp.map((h: any) => (
        <li><strong>{h.centro}</strong> <span class="uh-papel">{h.papel}</span><span class="uh-fuente"><a href={h.fuente.url} rel="noopener noreferrer">{h.fuente.titulo}</a></span></li>
      ))}
    </ul>
    {u.hospitales.nota && itemPublicable(u.hospitales.nota) && <p class="uh-nota">{u.hospitales.nota.texto} <a href={u.hospitales.nota.fuente.url} rel="noopener noreferrer">{u.hospitales.nota.fuente.titulo}</a></p>}
    <p class="uh-alerta">{u.hospitales.aviso}</p>
    <p class="aviso-caducado" role="status"></p>
  </div>}


  {visible(u.avisos) && avisos.length > 0 && <div class="uh-bloque" data-comprobado={u.avisos.comprobadoEn} data-revisar={u.avisos.revisarCadaMinutos}>
    <h3>Piden las autoridades</h3>
    <ul class="uh-lista">
      {avisos.map((a: any) => (
        <li>{a.texto}<span class="uh-fuente"><a href={a.fuente.url} rel="noopener noreferrer">{a.fuente.titulo}</a></span></li>
      ))}
    </ul>
    <p class="aviso-caducado" role="status"></p>
  </div>}

  {visible(u.linea) && <div class="uh-bloque" data-comprobado={u.linea.comprobadoEn} data-revisar={u.linea.revisarCadaMinutos}>
    <h3>La línea</h3>
    <p><strong>{u.linea.estado}.</strong> {u.linea.detalle} <span class="uh-fuente"><a href={u.linea.fuente.url} rel="noopener noreferrer">{u.linea.fuente.titulo}</a></span></p>
    <p class="aviso-caducado" role="status"></p>
  </div>}

  <p class="uh-pie">Cada dato enlaza al comunicado del organismo que lo da. <a href="actualizaciones.html">Todos los avisos y correcciones</a></p>
</section>
