---
// Alertas dentro de la página (sin notificaciones push, SMS ni correo).
// Comunicados marcados como alerta: visibles 60 minutos desde su publicación (requiere JavaScript para ocultarse a tiempo).
// Discrepancias de teléfonos oficiales: visibles siempre mientras existan.
import { actualizaciones, canales, horaCorta } from '../lib/datos';
const alertas = actualizaciones.filter((e) => e.alerta && e.estado === 'vigente');
const discrepancias = [...new Set(canales.filter((c: any) => c.discrepancia).map((c: any) => c.discrepancia as string))];
---
{(alertas.length > 0 || discrepancias.length > 0) && (
  <section class="alertas" aria-label="Alertas">
    {discrepancias.map((d) => <p class="alerta alerta-tel" role="alert"><strong>Atención a los teléfonos:</strong> {d}</p>)}
    {alertas.map((a) => (
      <p class="alerta alerta-nueva" hidden data-hasta={new Date(Date.parse(a.fechaComunicado) + 3600000).toISOString()}>
        <strong>Nuevo, {horaCorta(a.fechaComunicado)}:</strong> {a.titulo}. <a href={a.fuente.url} rel="noopener noreferrer">Ver fuente</a>
      </p>
    ))}
  </section>
)}
