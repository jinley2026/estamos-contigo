---
// Balance humano: cada cifra con organismo, fuente, fecha del comunicado, hora de verificación y estado.
// Si dos organismos dan cifras distintas se muestran las dos; nunca se calcula una intermedia ni ilesos por diferencia.
import { cifra, texto, TIPOS, cifraOficial } from '../lib/afirmaciones';
import { horaCorta, tipoFuenteTexto, NO_CONFIRMADO } from '../lib/datos';
const orden = ['fallecidos', 'heridos', 'hospitalizados', 'altas', 'pasajeros', 'atendidos'];
const cifras = orden.map((t) => cifra(t, 'global'));
const conDato = cifras.filter((c) => c.vigente);
const sinDato = cifras.filter((c) => !c.vigente);
---
<section class="balance" aria-labelledby="balance-titulo" id="balance">
  <h2 id="balance-titulo">Balance</h2>
  <ul class="cifras">
    {conDato.map((c) => {
      const a = c.vigente!;
      return (
        <li class="cifra">
          <span class="cifra-etiqueta">{TIPOS[c.tipo]}</span>
          <span class="cifra-valor">{texto(a)}</span>
          <span class="cifra-estado">{a.estadoDato === 'definitivo' ? 'Definitiva' : 'Provisional'}</span>
          <span class="cifra-fuente">Según {a.organismo}, {horaCorta(a.fechaComunicado)}. {a.fuente.tipoFuente === 'medio-citando' ? <>Publicado por <a href={a.fuente.url} rel="noopener noreferrer">{a.fuente.titulo.split(':')[0]}</a></> : <a href={a.fuente.url} rel="noopener noreferrer">Comunicado oficial</a>}</span>
          {a.observaciones && c.tipo === 'fallecidos' && <span class="cifra-nota">{a.observaciones}</span>}
          {c.discrepancias.length > 0 && (
            <span class="cifra-discrepancia">
              Otras cifras atribuidas: {c.discrepancias.map((d) => `${d.organismo}: ${texto(d)} (${horaCorta(d.fechaComunicado)})`).join(' · ')}
            </span>
          )}
        </li>
      );
    })}
  </ul>
  {sinDato.length > 0 && <p class="sin-cifra">Sin cifra comunicada todavía: {sinDato.map((c) => TIPOS[c.tipo].toLowerCase()).join(', ')}.</p>}
  <p class="uh-nota">Cada cifra indica qué organismo la da y dónde se ha publicado. Mostramos la más reciente atribuida a un organismo; no recogemos cifras sin autor ni hacemos estimaciones propias.</p>
</section>
