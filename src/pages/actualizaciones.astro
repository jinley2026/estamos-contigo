---
import Layout from '../components/Layout.astro';
import Entrada from '../components/Entrada.astro';
import { actualizaciones, correcciones, MODO } from '../lib/datos';
---
<Layout titulo="Actualizaciones contrastadas" descripcion="Avisos oficiales sobre el accidente, con fuente, hora y nivel de verificación.">
  <h1>Actualizaciones contrastadas</h1>
  <p class="subtitulo">
    Solo publicamos información útil para actuar, comunicada por un organismo u operador (nivel 1) o atribuida
    expresamente a uno por una agencia o medio (nivel 2). No publicamos cifras de víctimas ni identidades.
  </p>
  {MODO === 'reducido' ? (
    <p class="caja caja-pendiente">La web funciona en modo reducido: no estamos ofreciendo actualizaciones. Consulta directamente los canales oficiales.</p>
  ) : (
    <div class="solo-normal">
      {actualizaciones.map((e) => <Entrada e={e} />)}
    </div>
  )}

  <h2 id="fe-de-erratas">Fe de erratas</h2>
  {correcciones.length === 0 ? (
    <p>Sin correcciones hasta el momento. Si una información publicada resulta errónea, la marcaremos aquí sin borrarla, con lo que cambió y por qué.</p>
  ) : (
    <ul>{correcciones.map((c) => <li><strong>{c.titulo}</strong>: {c.correccion}</li>)}</ul>
  )}
  <p><a href="politica-editorial.html">Cómo verificamos la información</a></p>
</Layout>
