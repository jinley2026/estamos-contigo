---
// Página esencial por idioma (en, fr, pt, it, de). El número y el organismo se insertan desde los datos, sin traducir.
import Layout from '../components/Layout.astro';
import TarjetaTelefono from '../components/TarjetaTelefono.astro';
import MensajeFamilia from '../components/MensajeFamilia.astro';
import { i18n, operadores, SITE } from '../lib/datos';
export function getStaticPaths() {
  return ['en', 'fr', 'pt', 'it', 'de'].map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: 'en' | 'fr' | 'pt' | 'it' | 'de' };
const t = (i18n.textos as Record<string, any>)[lang];
const revisado = (i18n.idiomas as Record<string, any>)[lang].revisado;
---
<Layout titulo={t.titulo} descripcion={t.subtitulo} lang={lang}>
  <p class="banda-aviso-local caja" role="note"><strong>{t.aviso}</strong></p>
  {!revisado && <p class="borrador-legal" role="note">{t.pendienteRevision}</p>}
  <h1>{t.titulo}</h1>
  <p class="subtitulo">{t.subtitulo}</p>
  <TarjetaTelefono etiqueta={t.telefonoTitulo} textoPendiente={t.telefonoPendiente} textoFuente={t.fuente} textoComprobado={t.comprobado} textoLlamar={t.llamar} />
  <h2>{t.familiarTitulo}</h2>
  <p>{t.familiarTexto}</p>
  <h2>{t.pasajeroTitulo}</h2>
  <p>{t.pasajeroTexto}</p>
  {SITE.modulos.mensajeASalvo && (
    <>
      <h2>{t.mensajeTitulo}</h2>
      <MensajeFamilia lang={lang} />
    </>
  )}
  <h2>{t.viajeTitulo}</h2>
  <p>{t.viajeTexto}</p>
  <ul class="bloques">
    {operadores.map((o) => <li><a href={o.url} rel="noopener noreferrer" translate="no">{o.nombre}</a></li>)}
  </ul>
  <h2>{t.estafasTitulo}</h2>
  <p>{t.estafasTexto}</p>
  <p>{t.consulados}</p>
  <p><a href="index.html" lang="es" hreflang="es">{t.versionCompleta}</a></p>
</Layout>
