---
import Layout from '../components/Layout.astro';
import EstadoSistema from '../components/EstadoSistema.astro';
import Alertas from '../components/Alertas.astro';
import Balance from '../components/Balance.astro';
import FichasTrenes from '../components/FichasTrenes.astro';
import Directo from '../components/Directo.astro';
import Teletipo from '../components/Teletipo.astro';
import UltimaHora from '../components/UltimaHora.astro';
import Sello from '../components/Sello.astro';
import AvisoIndependencia from '../components/AvisoIndependencia.astro';
import { puntos, canales, SITE, ES_PREVIA, MODO, otrosCanales, visible, hecho, horaCorta, ultimahora, itemPublicable, confirmadoOficial } from '../lib/datos';
// Los teléfonos salen de los datos y respetan la verificación: nunca escritos a mano en la página.
const telFamilias = canales.filter((c: any) => ['renfe-familiares', 'iryo-familiares'].includes(c.id) && c.telefono && visible(c));
const fuentesHecho = hecho.fuentes.filter((f: any) => itemPublicable({ fuente: f, nivelFuente: f.tipoFuente === 'comunicado-oficial' ? 1 : 2 }));
const flecha = '<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const otros = otrosCanales.filter((c) => visible(c));
// Puntos para familiares agrupados por ciudad (Lin, 28/10 17:20): a la vista en la portada.
const CIUDADES = ['Madrid', 'Sevilla', 'Córdoba', 'Toledo', 'Málaga', 'Urda', 'Los Yébenes', 'Orgaz'];
const grupos = new Map<string, any[]>();
for (const p of puntos.filter((p: any) => visible(p))) {
  const t = `${p.nombre} ${p.direccion}`;
  const c = ['Toledo', 'Urda', 'Los Yébenes', 'Orgaz'].some((x) => t.includes(x)) && !t.includes('Comandancia de la Guardia Civil de Toledo') ? 'Provincia de Toledo' : (CIUDADES.find((x) => t.includes(x)) ?? 'Otros');
  if (!grupos.has(c)) grupos.set(c, []);
  grupos.get(c)!.push(p);
}
const ORDEN = ['Madrid', 'Sevilla', 'Córdoba', 'Toledo', 'Provincia de Toledo', 'Málaga', 'Otros'];
const ciudades = [...grupos.entries()].sort((a, b) => ORDEN.indexOf(a[0]) - ORDEN.indexOf(b[0]));
---
<Layout titulo={SITE.nombre} autorecarga ancho>
  <Teletipo slot="teletipo" />
  <section class="cabecera-compacta" aria-labelledby="titulo-suceso">
    <h1 id="titulo-suceso">{SITE.suceso.titulo}</h1>
    <div class="tel-rapidos">
      <span class="tel-rapidos-etiqueta">Familiares, llamad a:</span>
      {telFamilias.map((c: any) => <a class="tel-chip" href={`tel:${c.telefono}`}><span class="tel-chip-org">{c.id.startsWith('renfe') ? 'Renfe' : 'Iryo'}</span> {c.telefonoVisible}</a>)}
      {otros.filter((c: any) => !['renfe-familiares', 'iryo-familiares'].includes(c.id)).slice(0, 2).map((c: any) => <a class="tel-chip tel-chip-sec" href={`tel:${c.telefono}`}><span class="tel-chip-org">{c.id.includes('112') ? '112 Castilla-La Mancha' : (c.organismoCorto ?? c.organismo)}</span> {c.telefonoVisible}</a>)}
    </div>
  </section>

  <Alertas />

  <div class="portada-grid">
    <div class="portada-izq">
      <section class="familias" aria-labelledby="familias-titulo">
        <h2 id="familias-titulo">Dónde acudir si eres familiar</h2>
        <p class="familias-nota">Llama antes al teléfono de familiares. No vayas al lugar del accidente ni a urgencias.</p>
        {ciudades.map(([ciudad, lista]) => (
          <div class="familias-ciudad">
            <h3>{ciudad}</h3>
            <ul>
              {lista.map((p: any) => (
                <li>
                  <strong>{p.nombre.split(' — ')[0]}</strong>
                  <span class="familias-dir">{p.direccion}</span>
                  <span class="familias-fun">{p.funcion.split('. ')[0].replace(/\.$/, '')}.</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p><a href="puntos-de-atencion.html">Todos los puntos, con horarios y fuentes</a></p>
      </section>

      <ul class="que-hacer que-hacer-col" aria-label="Qué hacer ahora">
        <li>
          <h2>Si buscas a un familiar</h2>
          <p>Ten a mano su nombre completo, DNI y el tren. Los familiares de primer grado pueden aportar ADN en las oficinas de la Guardia Civil indicadas arriba.</p>
          <p><a href="busco-a-un-familiar.html">Qué más puedes hacer</a></p>
        </li>
        <li>
          <h2>Si tenías billete hoy</h2>
          <p>No vayas a la estación: la alta velocidad Madrid–Andalucía está cortada. Renfe cambia o anula el billete gratis.</p>
          <p><a href="viaje-afectado.html">Cambios y anulaciones</a></p>
        </li>
        <li>
          <h2>Si quieres ayudar</h2>
          <p>Antes de ir a donar sangre, consulta los avisos del tablón: Madrid pide esperar a mañana. No compartas fotos ni nombres de víctimas.</p>
          <p><a href="quiero-ayudar.html">Cómo ayudar sin estorbar</a></p>
        </li>
      </ul>
    </div>

    <div class="portada-der">
      <Directo limite={14} titulo="Tablón de noticias" />
    </div>
  </div>

  {MODO === 'reducido' ? (
    <p class="caja caja-pendiente">La web funciona en modo reducido: solo mostramos enlaces a los canales oficiales.</p>
  ) : (
    <div class="solo-normal">
      <section class="situacion" aria-labelledby="sit-titulo">
        <h2 id="sit-titulo">Qué ha pasado</h2>
        <p class="sit-resumen">{hecho.descripcion}</p>
        <dl class="sit-datos">
          <div><dt>Cuándo</dt><dd>28 de octubre, {horaCorta(hecho.hora)}</dd></div>
          <div><dt>Dónde</dt><dd>{hecho.lugar}</dd></div>
          <div><dt>Línea</dt><dd>{ultimahora.linea.estado}</dd></div>
        </dl>
        <p class="cifra-fuente">Fuentes: {fuentesHecho.map((f, i) => <>{i > 0 && ' · '}<a href={f.url} rel="noopener noreferrer">{f.titulo}</a></>)}</p>
        <p><a href="trenes.html">Trenes, organismos que intervienen y más detalles</a></p>
      </section>

      <Balance />
      <UltimaHora />
      <FichasTrenes />
    </div>
  )}

  <section class="buscador-acceso" aria-labelledby="buscar-titulo">
    <h2 id="buscar-titulo">¿Buscas un dato concreto?</h2>
    <a class="boton-buscar" href="buscar.html">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      Buscar en la información verificada
    </a>
  </section>

  <h2 id="rutas-titulo">¿Qué necesitas?</h2>
  <ul class="rutas" aria-labelledby="rutas-titulo">
    <li><a href="busco-a-un-familiar.html"><span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span><span><span class="ruta-titulo">Busco a un familiar</span><span class="ruta-desc">Qué preparar y qué hacer si no contestan</span></span><span class="flecha" set:html={flecha} /></a></li>
    <li><a href="iba-en-el-tren.html"><span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><span class="ruta-titulo">Iba en uno de los trenes</span><span class="ruta-desc">Avisa a tu familia en un minuto</span></span><span class="flecha" set:html={flecha} /></a></li>
    <li><a href="viaje-afectado.html"><span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M9 6v12" stroke="currentColor" stroke-width="2.2" stroke-dasharray="2.5 2.5"/></svg></span><span><span class="ruta-titulo">Tenía un billete</span><span class="ruta-desc">Cambios, anulaciones y estado de la línea</span></span><span class="flecha" set:html={flecha} /></a></li>
    <li><a href="quiero-ayudar.html"><span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg></span><span><span class="ruta-titulo">Quiero ayudar</span><span class="ruta-desc">Donar sangre y ayudar sin estorbar</span></span><span class="flecha" set:html={flecha} /></a></li>
  </ul>

  <ul class="avisos-rapidos" aria-label="Evita">
    <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>No vayas a la zona del accidente</li>
    <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>No pagues a nadie que prometa información</li>
    <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>No compartas fotos ni nombres de víctimas</li>
  </ul>

  <EstadoSistema />
  <AvisoIndependencia />

  <h2>También aquí</h2>
  <ul class="bloques">
    <li><a href="comunicados.html">Comunicados oficiales</a></li>
    <li><a href="puntos-de-atencion.html">Puntos de atención</a></li>
    <li><a href="apoyo-emocional.html">Ayuda emocional</a></li>
    <li><a href="preguntas-frecuentes.html">Preguntas frecuentes</a></li>
    <li><a href="alertas-estafas.html">Estafas: cómo protegerte</a></li>
    <li><a href="idiomas.html">Other languages</a></li>
  </ul>
</Layout>
