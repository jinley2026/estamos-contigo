---
import Layout from '../components/Layout.astro';
import TarjetaTelefono from '../components/TarjetaTelefono.astro';
import { SITE, actualizaciones, fechaHora, MODO } from '../lib/datos';
const ultima = actualizaciones[0];
const flecha = '<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Layout titulo={SITE.nombre}>
  <section class="panel" aria-labelledby="titulo-suceso">
    <h1 id="titulo-suceso">{SITE.suceso.titulo}</h1>
    <p class="pregunta">¿Buscas a un familiar que viajaba en los trenes?</p>
    <TarjetaTelefono />
  </section>

  <h2 id="rutas-titulo">¿Qué necesitas?</h2>
  <ul class="rutas" aria-labelledby="rutas-titulo">
    <li>
      <a href="busco-a-un-familiar.html">
        <span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>
        <span><span class="ruta-titulo">Busco a un familiar</span><span class="ruta-desc">Qué preparar y qué hacer si no contestan</span></span>
        <span class="flecha" set:html={flecha} />
      </a>
    </li>
    <li>
      <a href="iba-en-el-tren.html">
        <span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span><span class="ruta-titulo">Iba en uno de los trenes</span><span class="ruta-desc">Avisa a tu familia en un minuto</span></span>
        <span class="flecha" set:html={flecha} />
      </a>
    </li>
    <li>
      <a href="viaje-afectado.html">
        <span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M9 6v12" stroke="currentColor" stroke-width="2.2" stroke-dasharray="2.5 2.5"/></svg></span>
        <span><span class="ruta-titulo">Tenía un billete</span><span class="ruta-desc">Cambios, anulaciones y estado de la línea</span></span>
        <span class="flecha" set:html={flecha} />
      </a>
    </li>
    <li>
      <a href="quiero-ayudar.html">
        <span class="pictograma"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg></span>
        <span><span class="ruta-titulo">Quiero ayudar</span><span class="ruta-desc">Cómo ayudar sin estorbar</span></span>
        <span class="flecha" set:html={flecha} />
      </a>
    </li>
  </ul>

  <h2 class="visualmente-oculto" id="evita-titulo">Evita</h2>
  <ul class="avisos-rapidos" aria-labelledby="evita-titulo">
    <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>No vayas a la zona del accidente</li>
    <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>No pagues a nadie que prometa información</li>
    <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>No compartas fotos ni nombres de víctimas</li>
  </ul>

  {MODO !== 'reducido' && ultima && (
    <section class="solo-normal" aria-labelledby="ultima-titulo">
      <h2 id="ultima-titulo">Último aviso oficial</h2>
      <p><strong>{ultima.titulo}.</strong> <span class="meta">{fechaHora(ultima.fechaComunicado)}</span></p>
      <p><a href="actualizaciones.html">Todos los avisos y correcciones</a></p>
    </section>
  )}

  <h2>También aquí</h2>
  <ul class="bloques">
    <li><a href="puntos-de-atencion.html">Puntos de atención</a></li>
    <li><a href="apoyo-emocional.html">Ayuda emocional</a></li>
    <li><a href="preguntas-frecuentes.html">Preguntas frecuentes</a></li>
    <li><a href="alertas-estafas.html">Estafas: cómo protegerte</a></li>
    <li><a href="idiomas.html">Other languages</a></li>
    <li><a href="aviso-legal.html">Quiénes somos</a></li>
  </ul>
</Layout>
